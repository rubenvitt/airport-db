# ============================================
# Production Environment Configuration
# ============================================
# Kopiere diese Datei zu .env und fülle alle Werte aus
# WICHTIG: .env sollte NIEMALS in Git committed werden!
# ============================================

# ============================================
# API Configuration
# ============================================

# API URLs (Standard-Werte, normalerweise nicht ändern)
VITE_OPENSKY_API_URL=https://opensky-network.org/api
VITE_OPENSKY_AUTH_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
VITE_API_NINJAS_API_URL=https://api.api-ninjas.com/v1
NEXT_PUBLIC_API_URL=http://localhost:3000

# Ändere diese URL zu deiner Production Domain
# NEXT_PUBLIC_API_URL=https://airport.deine-domain.de

# ============================================
# API Keys (ERFORDERLICH)
# ============================================

# API Ninjas - Für Airport Daten
# Registrierung: https://api-ninjas.com/
VITE_API_NINJAS_API_KEY=

# OpenSky Network - Für Flugdaten (OAuth2)
# Registrierung: https://opensky-network.org/
# Erstelle OAuth2 Client in Account Settings
VITE_OPENSKY_CLIENT_ID=
VITE_OPENSKY_CLIENT_SECRET=

# ============================================
# Optional API Keys
# ============================================

# AviationStack (Optional) - Erweiterte Flugdaten
# Registrierung: https://aviationstack.com/
# VITE_AVIATIONSTACK_KEY=

# Mapbox (Optional) - Erweiterte Kartendarstellung
# Registrierung: https://www.mapbox.com/
# VITE_MAPBOX_TOKEN=

# ============================================
# Redis Configuration
# ============================================

# Redis Password (generiere mit: openssl rand -base64 32)
# WICHTIG: Verwende ein starkes Password in Production!
REDIS_PASSWORD=

# Redis Username (Standard: airport-app)
REDIS_USERNAME=airport-app

# Redis TLS/SSL (für verschlüsselte Verbindung)
REDIS_TLS_ENABLED=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Optional: Externe Redis Instance
# REDIS_URL=redis://username:password@redis-host:6379

# ============================================
# Secrets Management
# ============================================

# Secrets Source: env, file, vault, aws-secrets-manager, gcp-secret-manager
SECRETS_SOURCE=env

# Secrets Encryption Key (generiere mit: openssl rand -hex 32)
# WICHTIG: Sichere diesen Key gut!
SECRETS_ENCRYPTION_KEY=

# Für file-based secrets:
# SECRETS_PATH=.secrets

# ============================================
# Rate Limiting Configuration
# ============================================

# Fail Closed Mode (true = Anfragen blockieren bei Rate Limiter Fehler)
# In Production empfohlen: true
RATE_LIMIT_FAIL_CLOSED=true

# Circuit Breaker Einstellungen
REDIS_CIRCUIT_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_RESET_TIMEOUT=60000
REDIS_CIRCUIT_HALF_OPEN_REQUESTS=3

# ============================================
# Cache Configuration
# ============================================

# Airport Cache TTL (30 Tage in Sekunden)
AIRPORT_CACHE_TTL=2592000

# In-Memory Cache Fallback aktivieren (empfohlen für Ausfallsicherheit)
USE_IN_MEMORY_CACHE_FALLBACK=true

# ============================================
# Node Environment
# ============================================

NODE_ENV=production
